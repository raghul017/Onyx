generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

enum OrgRole {
  OWNER
  ADMIN
  VIEWER
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String? // user-set display name (optional)
  passwordHash  String? // null for OAuth-only accounts (Google / GitHub)
  googleId      String?   @unique
  githubId      String?   @unique
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  plan          Plan      @default(FREE)
  razorpaySubId String?   @unique
  planExpiresAt DateTime?

  testRuns        TestRun[]
  verifiedTargets VerifiedTarget[]
  orgMemberships  OrgMember[]
  authRecipes     AuthRecipe[]
  apiTokens       ApiToken[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Organization — multi-tenant workspace
// ---------------------------------------------------------------------------
model Organization {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  plan          Plan      @default(FREE)
  razorpaySubId String?
  planExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  members     OrgMember[]
  invites     OrgInvite[]
  testRuns    TestRun[]
  authRecipes AuthRecipe[]
  apiTokens   ApiToken[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// API Token — long-lived credential for non-interactive REST access (T10a).
// Stored as a SHA-256 hash only (never the plaintext); shown in full once on
// creation. Scoped to its owner (user, optionally pinned to an org) so a token
// does exactly what that user/org can do.
// ---------------------------------------------------------------------------
model ApiToken {
  id         String    @id @default(uuid())
  userId     String?
  orgId      String?
  name       String
  tokenHash  String    @unique // SHA-256 hex of the plaintext token
  last4      String // last 4 chars of the token, for masked display
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
  @@map("api_tokens")
}

// ---------------------------------------------------------------------------
// OrgMember — join table with role
// ---------------------------------------------------------------------------
model OrgMember {
  id       String   @id @default(uuid())
  orgId    String
  userId   String
  role     OrgRole  @default(VIEWER)
  joinedAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("org_members")
}

// ---------------------------------------------------------------------------
// OrgInvite — token-based invite (copy-link, no SMTP required)
// ---------------------------------------------------------------------------
model OrgInvite {
  id         String    @id @default(uuid())
  orgId      String
  email      String
  role       OrgRole   @default(VIEWER)
  token      String    @unique
  createdBy  String
  acceptedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([token])
  @@map("org_invites")
}

// ---------------------------------------------------------------------------
// Test Run — the top-level attack session
// ---------------------------------------------------------------------------
model TestRun {
  id                 String    @id @default(uuid())
  specUrl            String
  status             String    @default("PENDING") // PENDING | PARSING | GENERATING | ATTACKING | COMPLETED | FAILED
  totalEndpoints     Int       @default(0)
  totalAttacks       Int       @default(0)
  completedAttacks   Int       @default(0)
  // Baseline (control-request) job accounting, tracked separately so the
  // UI-facing attack counts above always mean ONLY attacks. The run completes
  // once both attacks AND baselines are done (see isRunComplete).
  totalBaselines     Int       @default(0)
  completedBaselines Int       @default(0)
  // Replay (BOLA cross-identity) job accounting (T13a), tracked separately like
  // baselines so attack progress stays clean. The run completes only once
  // attacks AND baselines AND replays are all done (see isRunComplete).
  totalReplays       Int       @default(0)
  completedReplays   Int       @default(0)
  enqueuedAt         DateTime? // set once ALL attack jobs are enqueued; guards premature completion
  // Denormalized score, computed once when the run reaches a terminal state so
  // the history list doesn't have to load every log to re-derive it. Nullable:
  // in-progress runs and pre-migration rows fall back to on-the-fly scoring.
  overallScore       Int?
  scoreLabel         String?
  errorMessage       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  completedAt        DateTime?

  userId String?
  user   User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  // Optional static credential (T7a) attached to every request in this run.
  // With T12, this remains the PRIMARY identity's recipe: the scan (baseline +
  // attacks) always runs under it, so the single-recipe/anonymous path is
  // unchanged. RunIdentity rows (below) add the primary + any secondaries.
  authRecipeId String?
  authRecipe   AuthRecipe? @relation(fields: [authRecipeId], references: [id], onDelete: SetNull)

  endpoints  TargetEndpoint[]
  logs       AttackLog[]
  baselines  BaselineResponse[]
  identities RunIdentity[]
  shares     ReportShare[]

  @@index([userId, createdAt])
  @@index([orgId, createdAt])
  @@map("test_runs")
}

// ---------------------------------------------------------------------------
// RunIdentity (T12) — an identity a run can attack as. Exactly ONE is primary
// (the scan runs under it, mirroring TestRun.authRecipeId). Secondaries are
// stored + ownership-validated so their credentials are resolvable per-identity
// for T13's cross-identity BOLA replays. authRecipeId null = an anonymous
// identity (no credential). Backward compat: legacy/anonymous runs get a single
// primary RunIdentity mirroring the run's authRecipeId (or anonymous).
// ---------------------------------------------------------------------------
model RunIdentity {
  id           String   @id @default(uuid())
  testRunId    String
  authRecipeId String? // null = anonymous identity (no credential)
  label        String // human label, e.g. "userA", "admin", "anon"
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  testRun    TestRun            @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  authRecipe AuthRecipe?        @relation(fields: [authRecipeId], references: [id], onDelete: SetNull)
  logs       AttackLog[]
  baselines  BaselineResponse[]

  @@unique([testRunId, label])
  @@index([testRunId])
  @@map("run_identities")
}

// ---------------------------------------------------------------------------
// Webhook Event — idempotency ledger for Razorpay webhook deliveries
// ---------------------------------------------------------------------------
model WebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique // Razorpay x-razorpay-event-id
  event       String
  processedAt DateTime @default(now())

  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Target Endpoint — parsed routes from the OpenAPI spec
// ---------------------------------------------------------------------------
model TargetEndpoint {
  id                String  @id @default(uuid())
  testRunId         String
  method            String // GET | POST | PUT | DELETE | PATCH
  path              String
  operationId       String?
  requestBodySchema Json? // raw JSON schema for the request body
  authRequirements  Json? // T7a: compact auth descriptors this endpoint expects (display-only)

  testRun   TestRun            @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  logs      AttackLog[]
  baselines BaselineResponse[]

  @@index([testRunId])
  @@map("target_endpoints")
}

// ---------------------------------------------------------------------------
// Auth Recipe — a static credential (bearer / apiKey / header / cookie) that a
// user (or org) can attach to a run so every request carries it (T7a). The
// secret is stored ENCRYPTED (AES-256-GCM, see lib/crypto.ts); `meta` holds
// only non-secret descriptors (header/query/cookie name, location, last4).
// ---------------------------------------------------------------------------
model AuthRecipe {
  id        String   @id @default(uuid())
  userId    String?
  orgId     String?
  name      String
  type      String // "bearer" | "apiKey" | "header" | "cookie"
  meta      Json // non-secret descriptors: headerName, queryName, location, cookieName, last4
  secretEnc String   @db.Text // encrypted secret value (never returned in full)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org        Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  testRuns   TestRun[]
  identities RunIdentity[]

  @@index([userId])
  @@index([orgId])
  @@map("auth_recipes")
}

// ---------------------------------------------------------------------------
// Baseline Response — a benign control request per endpoint (T5). Attack
// responses are diffed against this in T6 to confirm/deny findings.
// ---------------------------------------------------------------------------
model BaselineResponse {
  id          String   @id @default(uuid())
  testRunId   String
  endpointId  String
  status      Int?
  latencyMs   Int? // median of 2-3 fires to reduce noise
  bodyLength  Int?
  bodySnippet String?  @db.Text // redacted, capped ~500 chars
  identityId  String? // T12: the RunIdentity this baseline was captured as (primary)
  createdAt   DateTime @default(now())

  testRun  TestRun        @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  endpoint TargetEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  identity RunIdentity?   @relation(fields: [identityId], references: [id], onDelete: SetNull)

  @@unique([testRunId, endpointId])
  @@index([testRunId])
  @@map("baseline_responses")
}

// ---------------------------------------------------------------------------
// Verified Target — domain ownership proof before scanning
// ---------------------------------------------------------------------------
model VerifiedTarget {
  id         String    @id @default(uuid())
  userId     String
  domain     String
  token      String    @unique
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
  @@index([userId])
  @@map("verified_targets")
}

// ---------------------------------------------------------------------------
// Attack Log — individual payload execution results
// ---------------------------------------------------------------------------
model AttackLog {
  id                   String   @id @default(uuid())
  testRunId            String
  endpointId           String
  method               String
  path                 String
  payload              String   @db.Text
  statusCode           Int?
  latencyMs            Int?
  responseSnippet      String?  @db.Text
  attackType           String   @default("UNKNOWN")
  owaspCategory        String? // T9: OWASP API Top 10 (2023) code, or null = Unmapped
  identityId           String? // T12: the RunIdentity this attack was fired as (scan → primary)
  // BOLA machinery (T13a). Set on the paired A/B rows of a cross-identity replay
  // so T13b can group them by (endpointId, bolaObjectId) and diff A vs B.
  //   bolaObjectId         = the object id (acquired as A) that was requested.
  //   bolaSourceIdentityId = identity A (the resource owner). On the B (replay)
  //   row this points at A; on A's own capture row it equals identityId.
  bolaObjectId         String?
  bolaSourceIdentityId String?
  // Persisted finding (T13b). Most findings are recomputed from a single row by
  // analyzeFinding, but a BOLA verdict needs BOTH identities' responses — which
  // only exist together inside the replay job. So the verdict is computed once
  // and stored here; the read path prefers this over recomputation when set.
  findingJson          Json?
  // Re-scan state (T15b). resolvedAt is set when a re-run of THIS finding's
  // originating check no longer reproduces it; lastCheckedAt records when the
  // finding was last re-verified (set on every rescan, resolved or not).
  // Both null for rows that have never been re-scanned — i.e. every existing row.
  resolvedAt           DateTime?
  lastCheckedAt        DateTime?
  error                String?
  createdAt            DateTime @default(now())

  testRun  TestRun        @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  endpoint TargetEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  identity RunIdentity?   @relation(fields: [identityId], references: [id], onDelete: SetNull)

  @@index([testRunId])
  @@index([endpointId])
  @@index([identityId])
  @@map("attack_logs")
}

// ---------------------------------------------------------------------------
// ReportShare (T16a) — a tokenized, read-only public link to a run's report.
//
// The token is a CAPABILITY URL, not a password: possession alone grants access
// to that one report, so it is stored in plaintext and indexed for O(1) lookup
// (hashing would prevent the lookup without buying much — there is no user to
// impersonate and nothing to escalate to). Entropy is ~256 bits, so the token is
// not enumerable. Revocation is immediate via revokedAt.
//
// A run may have many share rows over time, but at most ONE active (revokedAt
// null) at a time — the create endpoint returns the existing active share rather
// than minting a second one.
// ---------------------------------------------------------------------------
model ReportShare {
  id              String    @id @default(uuid())
  testRunId       String
  token           String    @unique // ~256-bit base62 capability token
  createdByUserId String?
  orgId           String?
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  testRun TestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  @@index([testRunId])
  @@map("report_shares")
}
